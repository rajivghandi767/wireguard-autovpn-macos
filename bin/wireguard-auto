#!/usr/bin/env bash
# ==============================================================================
# wireguard-auto: Network-Aware WireGuard Daemon & CLI for macOS (Intel & ARM64)
# ==============================================================================

set -o pipefail
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"

VERSION="1.0.0"

# Prefer Homebrew Bash 4+ if installed, while remaining compatible with macOS /bin/bash 3.2+
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
    for candidate in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        if [[ -x "$candidate" ]]; then
            exec "$candidate" "$0" "$@"
        fi
    done
fi

# Dynamically detect Homebrew prefix (Apple Silicon vs Intel) unless overridden
if [[ -z "${BREW_PREFIX:-}" ]]; then
    if [[ -x "/opt/homebrew/bin/wg-quick" || -x "/opt/homebrew/bin/brew" || -d "/opt/homebrew/etc/wireguard" ]]; then
        BREW_PREFIX="/opt/homebrew"
    else
        BREW_PREFIX="/usr/local"
    fi
fi

WG_DIR="${WG_DIR:-${BREW_PREFIX}/etc/wireguard}"
CONFIG_FILE="${CONFIG_FILE:-${WG_DIR}/autovpn.conf}"
WG_QUICK_BIN="${WG_QUICK_BIN:-${BREW_PREFIX}/bin/wg-quick}"

DAEMON_ROOT="${DAEMON_ROOT:-/Library/Application Support/wireguard-auto}"
DAEMON_DIR="${DAEMON_ROOT}/bin"
DAEMON_BIN="${DAEMON_DIR}/wireguard-auto"
PLIST_DEST="${PLIST_DEST:-/Library/LaunchDaemons/com.wireguard.autovpn.plist}"

RUN_DIR="${RUN_DIR:-/var/run}"
LOG_FILE="${LOG_FILE:-/var/log/wireguard-auto.log}"
LOCK_DIR="${LOCK_DIR:-${RUN_DIR}/wireguard-auto.lock}"
TEMP_DISABLE_FLAG="${TEMP_DISABLE_FLAG:-${RUN_DIR}/wireguard-auto.paused}"
PERSIST_DISABLE_FLAG="${PERSIST_DISABLE_FLAG:-${WG_DIR}/.disabled}"

WG_INTERFACE="homevpn"
TRUSTED_SSIDS=()
TRUSTED_GATEWAY_MACS=()
SSID_REDACTED=0

log() {
    local msg
    msg="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
    printf '%s\n' "$msg"
    if [[ -w "$LOG_FILE" || ( ! -e "$LOG_FILE" && $EUID -eq 0 ) ]]; then
        # Rotate log file if it exceeds 5 MB (5242880 bytes)
        if [[ -f "$LOG_FILE" && ! -L "$LOG_FILE" ]]; then
            local size
            size=$(stat -f %z "$LOG_FILE" 2>/dev/null || echo 0)
            if (( size > 5242880 )); then
                mv -f "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || true
            fi
        fi
        if [[ ! -L "$LOG_FILE" ]]; then
            printf '%s\n' "$msg" >> "$LOG_FILE" 2>/dev/null || true
            if [[ $EUID -eq 0 ]]; then
                chmod 640 "$LOG_FILE" 2>/dev/null || true
            fi
        fi
    fi
}

verify_config_security() {
    local cfg="$1"
    if [[ ! -f "$cfg" ]]; then
        printf 'Error: Configuration file not found at %s\n' "$cfg" >&2
        return 1
    fi
    if [[ -L "$cfg" ]]; then
        printf 'Security Error: Configuration file %s must not be a symlink.\n' "$cfg" >&2
        return 1
    fi
    if [[ $EUID -eq 0 && "${SKIP_ROOT_OWNERSHIP_CHECK:-0}" != "1" ]]; then
        local owner_uid perm_octal perm_num
        owner_uid=$(stat -f %u "$cfg" 2>/dev/null || echo 999)
        perm_octal=$(stat -f %Lp "$cfg" 2>/dev/null || echo 777)
        perm_num=$(( 8#${perm_octal} ))
        if [[ "$owner_uid" != "0" ]] || (( (perm_num & 8#022) != 0 )); then
            log "Security Error: $cfg must be owned by root:wheel and not group/world-writable (fix with: sudo wireguard-auto install-daemon)."
            return 1
        fi
    fi
    return 0
}

# Safe declarative configuration parser (never executes source or eval)
parse_config() {
    local cfg="$1"
    verify_config_security "$cfg" || return 1

    WG_INTERFACE="homevpn"
    TRUSTED_SSIDS=()
    TRUSTED_GATEWAY_MACS=()

    local state="top"
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip leading/trailing whitespace
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"

        # Skip empty lines and full-line comments
        [[ -z "$line" || "$line" == \#* ]] && continue

        if [[ "$state" == "top" ]]; then
            if [[ "$line" =~ ^WG_INTERFACE[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]] || \
               [[ "$line" =~ ^WG_INTERFACE[[:space:]]*=[[:space:]]*\'([^\']+)\' ]] || \
               [[ "$line" =~ ^WG_INTERFACE[[:space:]]*=[[:space:]]*([^[:space:]#]+) ]]; then
                WG_INTERFACE="${BASH_REMATCH[1]}"
            elif [[ "$line" =~ ^TRUSTED_SSIDS[[:space:]]*=[[:space:]]*\((.*)$ ]]; then
                local rest="${BASH_REMATCH[1]}"
                if [[ "$rest" == *")"* ]]; then
                    rest="${rest%%\)*}"
                    _extract_array_items "$rest" "TRUSTED_SSIDS"
                else
                    _extract_array_items "$rest" "TRUSTED_SSIDS"
                    state="ssids"
                fi
            elif [[ "$line" =~ ^TRUSTED_GATEWAY_MACS[[:space:]]*=[[:space:]]*\((.*)$ ]]; then
                local rest="${BASH_REMATCH[1]}"
                if [[ "$rest" == *")"* ]]; then
                    rest="${rest%%\)*}"
                    _extract_array_items "$rest" "TRUSTED_GATEWAY_MACS"
                else
                    _extract_array_items "$rest" "TRUSTED_GATEWAY_MACS"
                    state="macs"
                fi
            fi
        elif [[ "$state" == "ssids" ]]; then
            if [[ "$line" == *")"* ]]; then
                local before="${line%%\)*}"
                _extract_array_items "$before" "TRUSTED_SSIDS"
                state="top"
            else
                _extract_array_items "$line" "TRUSTED_SSIDS"
            fi
        elif [[ "$state" == "macs" ]]; then
            if [[ "$line" == *")"* ]]; then
                local before="${line%%\)*}"
                _extract_array_items "$before" "TRUSTED_GATEWAY_MACS"
                state="top"
            else
                _extract_array_items "$line" "TRUSTED_GATEWAY_MACS"
            fi
        fi
    done < "$cfg"

    if [[ ! "$WG_INTERFACE" =~ ^[a-zA-Z0-9_-]{1,15}$ ]]; then
        printf 'Security Error: Invalid WG_INTERFACE "%s" (must be 1-15 alphanumeric, dash, or underscore characters).\n' "$WG_INTERFACE" >&2
        return 1
    fi
    return 0
}

_extract_array_items() {
    local input="$1"
    local target_array="$2"

    # Strip trailing inline comments outside quotes if line starts with #
    [[ "$input" == \#* ]] && return 0

    local remaining="$input"
    while [[ "$remaining" =~ \"([^\"]+)\" ]]; do
        local val="${BASH_REMATCH[1]}"
        if [[ "$target_array" == "TRUSTED_SSIDS" ]]; then
            TRUSTED_SSIDS+=("$val")
        else
            TRUSTED_GATEWAY_MACS+=("$val")
        fi
        remaining="${remaining#*\""${val}"\"}"
    done
}

# Normalize MAC addresses (e.g. BSD arp "0:1a:2b:c:d:e" -> "00:1a:2b:0c:0d:0e")
normalize_mac() {
    local raw="${1:-}"
    raw="${raw//-/:}"
    if [[ ! "$raw" =~ ^([0-9a-fA-F]{1,2}):([0-9a-fA-F]{1,2}):([0-9a-fA-F]{1,2}):([0-9a-fA-F]{1,2}):([0-9a-fA-F]{1,2}):([0-9a-fA-F]{1,2})$ ]]; then
        return 1
    fi
    printf '%02x:%02x:%02x:%02x:%02x:%02x\n' \
        "$((16#${BASH_REMATCH[1]}))" \
        "$((16#${BASH_REMATCH[2]}))" \
        "$((16#${BASH_REMATCH[3]}))" \
        "$((16#${BASH_REMATCH[4]}))" \
        "$((16#${BASH_REMATCH[5]}))" \
        "$((16#${BASH_REMATCH[6]}))"
}

acquire_lock() {
    local attempts=5
    while (( attempts > 0 )); do
        if mkdir "$LOCK_DIR" 2>/dev/null; then
            printf '%s\n' "$$" > "${LOCK_DIR}/pid" 2>/dev/null || true
            return 0
        fi
        local mtime now
        mtime=$(stat -f %m "$LOCK_DIR" 2>/dev/null || echo 0)
        now=$(date +%s)
        if (( now - mtime > 45 )); then
            rm -f "${LOCK_DIR}/pid" 2>/dev/null || true
            rmdir "$LOCK_DIR" 2>/dev/null || true
            if mkdir "$LOCK_DIR" 2>/dev/null; then
                printf '%s\n' "$$" > "${LOCK_DIR}/pid" 2>/dev/null || true
                return 0
            fi
        fi
        sleep 1
        (( attempts-- ))
    done
    return 1
}

release_lock() {
    rm -f "${LOCK_DIR}/pid" 2>/dev/null || true
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

is_wg_active() {
    local name_file="/var/run/wireguard/${WG_INTERFACE}.name"
    if [[ -f "$name_file" ]]; then
        local iface
        iface=$(head -n 1 "$name_file" 2>/dev/null)
        if [[ "$iface" =~ ^utun[0-9]+$ ]]; then
            if ifconfig "$iface" &>/dev/null; then
                return 0
            fi
            # Clean up stale state if interface no longer exists in kernel
            if [[ $EUID -eq 0 ]]; then
                rm -f "$name_file" "/var/run/wireguard/${iface}.sock" 2>/dev/null || true
            fi
        fi
    fi

    # Fallback check: interface IP address active in kernel
    local conf_path="${WG_DIR}/${WG_INTERFACE}.conf"
    if [[ -f "$conf_path" ]]; then
        local ip
        ip=$(sed -n 's/^[[:space:]]*Address[[:space:]]*=[[:space:]]*\([0-9.]*\).*/\1/p' "$conf_path" 2>/dev/null | head -n 1)
        if [[ -n "$ip" && "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && ifconfig 2>/dev/null | grep -q "inet $ip "; then
            return 0
        fi
    fi
    return 1
}

get_endpoint_host() {
    local conf_path="${WG_DIR}/${WG_INTERFACE}.conf"
    if [[ -f "$conf_path" ]]; then
        # Handle IPv6 [addr]:port or IPv4/hostname host:port
        local raw_ep
        raw_ep=$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$conf_path" 2>/dev/null | head -n 1)
        if [[ "$raw_ep" =~ ^\[([^\]]+)\]:[0-9]+$ ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
        elif [[ "$raw_ep" =~ ^([^:]+):[0-9]+$ ]]; then
            printf '%s\n' "${BASH_REMATCH[1]}"
        fi
    fi
}

get_wifi_device() {
    /usr/sbin/networksetup -listallhardwareports 2>/dev/null | awk '/Wi-Fi|AirPort/{getline; print $2; exit}'
}

get_current_ssid() {
    SSID_REDACTED=0
    local wifi_dev
    wifi_dev=$(get_wifi_device)
    wifi_dev="${wifi_dev:-en0}"

    local output
    output=$(/usr/sbin/networksetup -getairportnetwork "$wifi_dev" 2>/dev/null | sed -E 's/^Current Wi-Fi Network: //')
    if [[ "$output" == *"<redacted>"* ]]; then
        SSID_REDACTED=1
        output=""
    elif [[ "$output" == *"You are not associated"* || -z "$output" ]]; then
        output=""
    fi

    if [[ -z "$output" ]]; then
        # Fallback for macOS Sonoma / Sequoia / Tahoe via ipconfig summary
        local ipcfg_ssid
        ipcfg_ssid=$(/usr/sbin/ipconfig getsummary "$wifi_dev" 2>/dev/null | awk -F ' SSID : ' '/ SSID : / {print $2}' | head -n 1)
        if [[ "$ipcfg_ssid" == *"<redacted>"* ]]; then
            SSID_REDACTED=1
            output=""
        elif [[ -n "$ipcfg_ssid" ]]; then
            SSID_REDACTED=0
            output="$ipcfg_ssid"
        fi
    fi
    printf '%s\n' "$output"
}

get_gateway_mac() {
    local wifi_dev gw_ip
    wifi_dev=$(get_wifi_device)
    wifi_dev="${wifi_dev:-en0}"

    # Prefer physical Wi-Fi DHCP router IP so full-tunnel VPNs (NordVPN) do not mask the LAN gateway
    gw_ip=$(/usr/sbin/ipconfig getoption "$wifi_dev" router 2>/dev/null | head -n 1)
    if [[ -z "$gw_ip" ]]; then
        gw_ip=$(/sbin/route -n get default 2>/dev/null | awk '/gateway:/ {print $2}' | head -n 1)
    fi

    if [[ -n "$gw_ip" && "$gw_ip" =~ ^[0-9a-fA-F.:]+$ ]]; then
        local raw_mac
        raw_mac=$(/usr/sbin/arp -n "$gw_ip" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^([0-9a-fA-F]{1,2}:){5}[0-9a-fA-F]{1,2}$/) {print $i; exit}}')
        if [[ -z "$raw_mac" ]]; then
            # Warm the kernel ARP cache with a single 1-second timeout ping (-t 1 on BSD/macOS)
            /sbin/ping -c 1 -t 1 "$gw_ip" >/dev/null 2>&1 || true
            raw_mac=$(/usr/sbin/arp -n "$gw_ip" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i ~ /^([0-9a-fA-F]{1,2}:){5}[0-9a-fA-F]{1,2}$/) {print $i; exit}}')
        fi
        if [[ -n "$raw_mac" ]]; then
            normalize_mac "$raw_mac" 2>/dev/null || true
        fi
    fi
}

is_trusted_network() {
    local current_ssid="$1"
    if [[ -n "$current_ssid" && "${#TRUSTED_SSIDS[@]}" -gt 0 ]]; then
        local trusted
        for trusted in "${TRUSTED_SSIDS[@]}"; do
            if [[ "$current_ssid" == "$trusted" ]]; then
                return 0
            fi
        done
    fi

    if [[ "${#TRUSTED_GATEWAY_MACS[@]}" -gt 0 ]]; then
        local gw_mac
        gw_mac=$(get_gateway_mac)
        if [[ -n "$gw_mac" ]]; then
            local trusted_mac norm_trusted
            for trusted_mac in "${TRUSTED_GATEWAY_MACS[@]}"; do
                if [[ -n "$trusted_mac" ]]; then
                    norm_trusted=$(normalize_mac "$trusted_mac" 2>/dev/null || true)
                    if [[ -n "$norm_trusted" && "$gw_mac" == "$norm_trusted" ]]; then
                        return 0
                    fi
                fi
            done
        fi
    fi
    return 1
}

is_disabled() {
    [[ -f "$TEMP_DISABLE_FLAG" || -f "$PERSIST_DISABLE_FLAG" ]]
}

has_default_route() {
    /sbin/route -n get default &>/dev/null
}

wait_for_network_readiness() {
    local endpoint_host="$1"
    local max_attempts=8
    local attempt=1

    while (( attempt <= max_attempts )); do
        if has_default_route; then
            if [[ -z "$endpoint_host" ]]; then
                return 0
            fi
            # If Endpoint is already an IPv4 or IPv6 literal, skip DNS lookup
            if [[ "$endpoint_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ || "$endpoint_host" == *:* ]]; then
                return 0
            fi
            if [[ "$endpoint_host" =~ ^[a-zA-Z0-9._-]+$ ]]; then
                if dscacheutil -q host -a name "$endpoint_host" 2>/dev/null | grep -q "ip_address:"; then
                    return 0
                fi
            fi
        fi
        sleep 1
        (( attempt++ ))
    done
    return 1
}

cmd_check() {
    if ! acquire_lock; then
        log "Another instance of wireguard-auto is running. Exiting."
        exit 0
    fi
    trap release_lock EXIT

    if [[ "${SKIP_CHECK_SLEEP:-0}" != "1" ]]; then
        # Allow network / DHCP / VPN handshakes to settle
        sleep 2
    fi

    local current_ssid
    current_ssid=$(get_current_ssid)

    if is_disabled; then
        log "Auto-VPN is currently paused or disabled."
        if is_wg_active; then
            log "Tearing down $WG_INTERFACE because auto-vpn is disabled..."
            "$WG_QUICK_BIN" down "$WG_INTERFACE"
        fi
        exit 0
    fi

    if [[ "${#TRUSTED_SSIDS[@]}" -eq 0 && "${#TRUSTED_GATEWAY_MACS[@]}" -eq 0 ]]; then
        log "Warning: No TRUSTED_SSIDS or TRUSTED_GATEWAY_MACS configured in $CONFIG_FILE."
    fi

    if (( SSID_REDACTED == 1 )) && [[ "${#TRUSTED_GATEWAY_MACS[@]}" -eq 0 ]]; then
        log "Warning: macOS redacted the Wi-Fi SSID (<redacted>) and no TRUSTED_GATEWAY_MACS are configured in $CONFIG_FILE. Configure TRUSTED_GATEWAY_MACS for macOS Sonoma/Sequoia/Tahoe support."
    fi

    if is_trusted_network "$current_ssid"; then
        log "Connected to trusted home network: '${current_ssid:-Gateway MAC Match}'."
        if is_wg_active; then
            log "Tearing down $WG_INTERFACE..."
            "$WG_QUICK_BIN" down "$WG_INTERFACE"
        else
            log "WireGuard is already down."
        fi
        exit 0
    fi

    local net_desc="$current_ssid"
    if [[ -z "$net_desc" ]]; then
        if (( SSID_REDACTED == 1 )); then
            net_desc="Redacted Wi-Fi SSID"
        else
            net_desc="Non-WiFi / Cellular / Ethernet"
        fi
    fi

    if is_wg_active; then
        log "Away from home network ($net_desc). WireGuard ($WG_INTERFACE) is already active."
        exit 0
    fi

    # Preflight check: Wait for default route and DNS readiness (coexisting with NordVPN auto-connect)
    local endpoint_host
    endpoint_host=$(get_endpoint_host)

    if ! wait_for_network_readiness "$endpoint_host"; then
        log "Network route or DNS for '$endpoint_host' is not ready yet. Postponing connection until next trigger."
        exit 0
    fi

    log "Away from home network ($net_desc). Bringing up WireGuard ($WG_INTERFACE)..."
    "$WG_QUICK_BIN" up "$WG_INTERFACE"
}

cmd_pause() {
    if [[ $EUID -ne 0 && "${SKIP_ROOT_OWNERSHIP_CHECK:-0}" != "1" ]]; then
        printf 'Elevating privileges to pause WireGuard auto-connect...\n'
        exec sudo "$0" pause
    fi
    if [[ -L "$TEMP_DISABLE_FLAG" ]]; then
        rm -f "$TEMP_DISABLE_FLAG"
    fi
    touch "$TEMP_DISABLE_FLAG"
    chmod 644 "$TEMP_DISABLE_FLAG" 2>/dev/null || true
    printf 'WireGuard auto-connect paused (temporary flag created at %s).\n' "$TEMP_DISABLE_FLAG"
    if is_wg_active; then
        "$WG_QUICK_BIN" down "$WG_INTERFACE"
    else
        printf 'WireGuard (%s) is already down.\n' "$WG_INTERFACE"
    fi
    printf "Run 'wireguard-auto resume' to re-enable auto-connect.\n"
}

cmd_resume() {
    if [[ $EUID -ne 0 && "${SKIP_ROOT_OWNERSHIP_CHECK:-0}" != "1" ]]; then
        printf 'Elevating privileges to resume WireGuard auto-connect...\n'
        exec sudo "$0" resume
    fi
    rm -f "$TEMP_DISABLE_FLAG" "$PERSIST_DISABLE_FLAG"
    printf 'WireGuard auto-connect resumed. Triggering network check...\n'
    cmd_check
}

cmd_disable() {
    if [[ $EUID -ne 0 && "${SKIP_ROOT_OWNERSHIP_CHECK:-0}" != "1" ]]; then
        printf 'Elevating privileges to disable WireGuard auto-connect...\n'
        exec sudo "$0" disable
    fi
    if [[ -L "$PERSIST_DISABLE_FLAG" ]]; then
        rm -f "$PERSIST_DISABLE_FLAG"
    fi
    touch "$PERSIST_DISABLE_FLAG"
    chmod 644 "$PERSIST_DISABLE_FLAG" 2>/dev/null || true
    printf 'WireGuard auto-connect persistently disabled (flag created at %s).\n' "$PERSIST_DISABLE_FLAG"
    if is_wg_active; then
        "$WG_QUICK_BIN" down "$WG_INTERFACE"
    else
        printf 'WireGuard (%s) is already down.\n' "$WG_INTERFACE"
    fi
}

cmd_install_daemon() {
    if [[ $EUID -ne 0 ]]; then
        printf 'Elevating privileges with sudo to install LaunchDaemon...\n'
        exec sudo "$0" install-daemon
    fi

    printf '==> Detected Homebrew prefix: %s\n' "$BREW_PREFIX"

    local tool
    for tool in bash wg wg-quick wireguard-go; do
        if [[ ! -x "${BREW_PREFIX}/bin/${tool}" ]]; then
            printf "Error: Required binary '%s/bin/%s' not found.\n" "$BREW_PREFIX" "$tool" >&2
            printf 'Please run: brew install bash wireguard-tools\n' >&2
            exit 1
        fi
    done

    mkdir -p "$WG_DIR" "${BREW_PREFIX}/bin" "$DAEMON_DIR"

    chown root:wheel "$DAEMON_ROOT" "$DAEMON_DIR"
    chmod 755 "$DAEMON_ROOT" "$DAEMON_DIR"
    chown root:wheel "$WG_DIR"
    chmod 755 "$WG_DIR"

    # Harden existing WireGuard tunnel configs (*.conf except autovpn.conf) to 0600 root:wheel
    local wg_conf
    for wg_conf in "$WG_DIR"/*.conf; do
        [[ -e "$wg_conf" ]] || continue
        if [[ "$(basename "$wg_conf")" != "autovpn.conf" ]]; then
            chown root:wheel "$wg_conf"
            chmod 600 "$wg_conf"
        fi
    done

    # Resolve current executable path and copy to root-protected /Library/Application Support
    local self_bin
    self_bin="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    printf '==> Installing root daemon executable (v%s) to %s...\n' "$VERSION" "$DAEMON_BIN"
    if [[ "$self_bin" != "$DAEMON_BIN" ]]; then
        cp "$self_bin" "$DAEMON_BIN"
    fi
    chown root:wheel "$DAEMON_BIN"
    chmod 755 "$DAEMON_BIN"

    # Create CLI symlink in Homebrew bin unless managed by Homebrew Cellar
    local cli_link="${BREW_PREFIX}/bin/wireguard-auto"
    if [[ ! -e "$cli_link" && ! -L "$cli_link" ]]; then
        printf '==> Linking CLI binary at %s...\n' "$cli_link"
        ln -sf "$DAEMON_BIN" "$cli_link"
    elif [[ -L "$cli_link" ]]; then
        local link_target
        link_target=$(readlink "$cli_link" 2>/dev/null || true)
        if [[ "$link_target" != *"Cellar"* ]]; then
            ln -sf "$DAEMON_BIN" "$cli_link"
        fi
    elif [[ "$self_bin" != "$cli_link" ]]; then
        ln -sf "$DAEMON_BIN" "$cli_link"
    fi

    # Create default configuration if not present and lock down ownership to root:wheel
    if [[ ! -f "$CONFIG_FILE" ]]; then
        printf '==> Creating default configuration at %s...\n' "$CONFIG_FILE"
        cat > "$CONFIG_FILE" <<'EOF'
# ==============================================================================
# WireGuard Auto-Connect Configuration
# ==============================================================================
# Note: This file is parsed declaratively (never sourced as shell code) and must
# remain owned by root:wheel (chmod 644).

# WireGuard interface name (corresponds to <BREW_PREFIX>/etc/wireguard/<WG_INTERFACE>.conf)
WG_INTERFACE="homevpn"

# Trusted Wi-Fi networks where WireGuard should remain DISCONNECTED.
# Add more SSIDs by placing them in double quotes inside the array.
TRUSTED_SSIDS=(
    "Your-Home-WiFi-SSID"
    # "Office-WiFi"
)

# Recommended for M-Series Macs / macOS Sonoma 14.4+, Sequoia 15, and Tahoe 16:
# Trusted Gateway MAC Addresses (ARP fallback when macOS Location Services
# redacts Wi-Fi SSIDs as "<redacted>" for background daemons).
#
# While connected to your home Wi-Fi, run:
#   wireguard-auto status
# and copy the "Current Gateway MAC" value into the array below:
TRUSTED_GATEWAY_MACS=(
    # "aa:bb:cc:dd:ee:ff"
)
EOF
    else
        printf '==> Existing configuration found at %s (preserved).\n' "$CONFIG_FILE"
    fi
    chown root:wheel "$CONFIG_FILE"
    chmod 644 "$CONFIG_FILE"

    printf '==> Installing LaunchDaemon to %s...\n' "$PLIST_DEST"
    cat > "$PLIST_DEST" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wireguard.autovpn</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/wireguard-auto/bin/wireguard-auto</string>
        <string>check</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Allow wireguard-go daemon to survive after the check script exits -->
    <key>AbandonProcessGroup</key>
    <true/>

    <!-- Debounce trigger interval (in seconds) -->
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Periodic sanity check every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Trigger execution whenever network state or Wi-Fi configuration changes -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist</string>
        <string>/Library/Preferences/SystemConfiguration/preferences.plist</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/var/log/wireguard-auto.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/wireguard-auto.log</string>
</dict>
</plist>
EOF
    chown root:wheel "$PLIST_DEST"
    chmod 644 "$PLIST_DEST"
    plutil -lint "$PLIST_DEST"

    printf '==> Loading com.wireguard.autovpn daemon...\n'
    launchctl bootout system "$PLIST_DEST" 2>/dev/null || launchctl unload "$PLIST_DEST" 2>/dev/null || true
    if ! launchctl bootstrap system "$PLIST_DEST" 2>/dev/null; then
        launchctl load -w "$PLIST_DEST"
    fi

    printf '\n==> Installation complete (wireguard-auto v%s)!\n' "$VERSION"
    printf '    Config file : %s\n' "$CONFIG_FILE"
    printf "    Run 'wireguard-auto status' to verify your current network and gateway MAC.\n"
}

cmd_uninstall_daemon() {
    if [[ $EUID -ne 0 ]]; then
        printf 'Elevating privileges with sudo to uninstall LaunchDaemon...\n'
        exec sudo "$0" uninstall-daemon
    fi

    if [[ -f "$PLIST_DEST" ]]; then
        printf '==> Unloading and removing %s...\n' "$PLIST_DEST"
        launchctl bootout system "$PLIST_DEST" 2>/dev/null || launchctl unload -w "$PLIST_DEST" 2>/dev/null || true
        rm -f "$PLIST_DEST"
    fi

    local cli_link="${BREW_PREFIX}/bin/wireguard-auto"
    if [[ -L "$cli_link" ]]; then
        local link_target
        link_target=$(readlink "$cli_link" 2>/dev/null || true)
        if [[ "$link_target" != *"Cellar"* ]]; then
            printf '==> Removing CLI link %s...\n' "$cli_link"
            rm -f "$cli_link"
        fi
    fi

    if [[ -d "$DAEMON_ROOT" ]]; then
        printf '==> Removing daemon directory %s...\n' "$DAEMON_ROOT"
        rm -f "$DAEMON_BIN"
        rmdir "$DAEMON_DIR" "$DAEMON_ROOT" 2>/dev/null || true
    fi

    rm -f "${LOCK_DIR}/pid" "$TEMP_DISABLE_FLAG"
    rmdir "$LOCK_DIR" 2>/dev/null || true

    printf '==> Uninstalled wireguard-auto LaunchDaemon.\n'
    printf '    Note: Your WireGuard configs in %s/ were preserved.\n' "$WG_DIR"
}

cmd_status() {
    local current_ssid
    current_ssid=$(get_current_ssid)
    local def_gw_int
    def_gw_int=$(/sbin/route -n get default 2>/dev/null | awk '/interface:/ {print $2}' | head -n 1)
    local gw_mac
    gw_mac=$(get_gateway_mac)

    local ssid_display
    if [[ -n "$current_ssid" ]]; then
        ssid_display="$current_ssid"
    elif (( SSID_REDACTED == 1 )); then
        ssid_display="<Redacted by macOS Privacy — use TRUSTED_GATEWAY_MACS>"
    else
        ssid_display="<Not connected to Wi-Fi>"
    fi

    printf '==============================================\n'
    printf '         WireGuard Auto-VPN Status            \n'
    printf '==============================================\n'
    printf 'Version             : v%s\n' "$VERSION"
    printf 'Homebrew Prefix     : %s\n' "$BREW_PREFIX"
    printf 'Configured Profile  : %s\n' "$WG_INTERFACE"
    printf 'Trusted SSID(s)     : %s\n' "${TRUSTED_SSIDS[*]:-<None>}"
    printf 'Trusted Gateway MACs: %s\n' "${TRUSTED_GATEWAY_MACS[*]:-<None>}"
    printf 'Current SSID        : %s\n' "$ssid_display"
    printf 'Current Gateway MAC : %s\n' "${gw_mac:-<None>}"
    printf 'Default Gateway Int : %s\n' "${def_gw_int:-<None>}"

    if is_wg_active; then
        printf 'WireGuard Interface : UP (active)\n'
    else
        printf 'WireGuard Interface : DOWN (inactive)\n'
    fi

    if [[ -f "$TEMP_DISABLE_FLAG" ]]; then
        printf 'Auto-Connect Mode   : PAUSED (temporary: %s)\n' "$TEMP_DISABLE_FLAG"
    elif [[ -f "$PERSIST_DISABLE_FLAG" ]]; then
        printf 'Auto-Connect Mode   : DISABLED (persistent: %s)\n' "$PERSIST_DISABLE_FLAG"
    else
        printf 'Auto-Connect Mode   : ENABLED (automatic)\n'
    fi
    printf '==============================================\n'
}

cmd_version() {
    printf 'wireguard-auto v%s\n' "$VERSION"
}

cmd_help() {
    cat <<EOF
wireguard-auto v${VERSION}
Usage: wireguard-auto [command]

Commands:
  check             Evaluate network and activate/deactivate WireGuard (called by launchd)
  status            Show current Wi-Fi network, gateway MAC, WireGuard state, and mode
  pause             Temporarily disable auto-connect and bring down WireGuard (captive portals)
  resume            Re-enable auto-connect and evaluate current network
  disable           Persistently disable auto-connect across reboots
  enable            Same as resume
  install-daemon    Install/update and load the root LaunchDaemon (requires sudo)
  uninstall-daemon  Unload and remove the root LaunchDaemon (requires sudo)
  version           Display version information
  help              Display this help message

Configuration file: $CONFIG_FILE
EOF
}

# Allow unit tests to source helper functions without executing the CLI entrypoint
if [[ "${WIREGUARD_AUTO_SOURCE_ONLY:-0}" == "1" ]]; then
    # shellcheck disable=SC2317
    return 0 2>/dev/null || exit 0
fi

case "${1:-check}" in
    help|--help|-h)
        cmd_help
        exit 0
        ;;
    version|--version|-v)
        cmd_version
        exit 0
        ;;
    install-daemon)
        cmd_install_daemon
        exit 0
        ;;
    uninstall-daemon)
        cmd_uninstall_daemon
        exit 0
        ;;
esac

# Load and validate user configuration
if ! parse_config "$CONFIG_FILE"; then
    exit 1
fi

case "${1:-check}" in
    check)
        cmd_check
        ;;
    status)
        cmd_status
        ;;
    pause)
        cmd_pause
        ;;
    resume|enable)
        cmd_resume
        ;;
    disable)
        cmd_disable
        ;;
    *)
        printf 'Unknown command: %s\n' "$1" >&2
        cmd_help
        exit 1
        ;;
esac
